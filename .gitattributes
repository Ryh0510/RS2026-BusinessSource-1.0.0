# Default: normalize text files in git, checkout as CRLF on Windows
* text=auto

# C/C++ / CMake / Qt files
*.h      text eol=crlf
*.hpp    text eol=crlf
*.cpp    text eol=crlf
*.cxx    text eol=crlf
*.c      text eol=crlf
*.cmake  text eol=crlf
CMakeLists.txt text eol=crlf
*.ui     text eol=crlf
*.qrc    text eol=crlf

# Scripts can keep LF if needed
*.sh     text eol=lf
*.py     text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.dll binary
*.lib binary
*.exe binary
*.pdb binary