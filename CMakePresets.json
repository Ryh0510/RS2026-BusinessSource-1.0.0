        "BuildTests": "OFF",
        "BuildRegression": "OFF",
        "BuildFeatureProbes": "OFF",
        "BuildDiagnostics": "OFF",
        "BuildExternalValidation": "OFF",
        "BuildTutorials": "OFF"
