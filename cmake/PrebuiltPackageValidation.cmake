include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/RS2026CacheOptionNames.cmake")
set(SMROBOT_PREBUILT_EXPECTED_VERSION "${PROJECT_VERSION}" CACHE STRING
    "Exact version expected when importing project packages")
rs2026_named_cache_option(UsingPrebuilt_RequireBuildMetadata
    SMROBOT_PREBUILT_REQUIRE_BUILD_METADATA
    "Reject legacy project packages without build identity metadata" OFF)
if(CMAKE_CONFIGURATION_TYPES)
    set(_rs_required_configs Debug Release)
elseif(CMAKE_BUILD_TYPE)
    set(_rs_required_configs "${CMAKE_BUILD_TYPE}")
else()
    set(_rs_required_configs Release)
endif()
set(SMROBOT_PREBUILT_REQUIRED_CONFIGURATIONS "${_rs_required_configs}" CACHE STRING
    "Configurations required from imported project binaries")

function(rs_check_path_within root path description)
    get_filename_component(_root "${root}" REALPATH)
    get_filename_component(_path "${path}" REALPATH)
    file(RELATIVE_PATH _relative "${_root}" "${_path}")
    if(IS_ABSOLUTE "${_relative}" OR _relative MATCHES "^[.][.](/|$)")
        message(FATAL_ERROR "[PrebuiltIdentity] ${description} points outside the selected package: ${_path}; expected ${_root}")
    endif()
endfunction()

function(rs_effective_msvc_runtime out)
    if(CMAKE_MSVC_RUNTIME_LIBRARY)
        set(${out} "${CMAKE_MSVC_RUNTIME_LIBRARY}" PARENT_SCOPE)
    else()
        set(${out} "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL" PARENT_SCOPE)
    endif()
endfunction()

function(rs_build_architecture out)
    if(CMAKE_GENERATOR_PLATFORM)
        set(_arch "${CMAKE_GENERATOR_PLATFORM}")
    elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
        set(_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
    else()
        set(_arch "${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    string(REGEX REPLACE ",.*$" "" _arch "${_arch}")
    string(TOLOWER "${_arch}" _arch)
    if(_arch MATCHES "^(amd64|x86_64|x64)$")
        set(_arch x64)
    elseif(_arch MATCHES "^(aarch64|arm64)$")
        set(_arch arm64)
    elseif(_arch MATCHES "^(x86|win32|i[3-6]86)$")
        set(_arch x86)
    endif()
    set(${out} "${_arch}" PARENT_SCOPE)
endfunction()

function(rs_register_package_build_info package)
    set(_fields PACKAGE VERSION SYSTEM ARCHITECTURE POINTER_SIZE COMPILER_ID COMPILER_VERSION TOOLSET CRT CONFIGURATIONS)
    set(_PACKAGE "${package}")
    set(_VERSION "${PROJECT_VERSION}")
    set(_SYSTEM "${CMAKE_SYSTEM_NAME}")
    rs_build_architecture(_ARCHITECTURE)
    set(_POINTER_SIZE "${CMAKE_SIZEOF_VOID_P}")
    set(_COMPILER_ID "${CMAKE_CXX_COMPILER_ID}")
    set(_COMPILER_VERSION "${CMAKE_CXX_COMPILER_VERSION}")
    set(_TOOLSET "${MSVC_TOOLSET_VERSION}")
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        rs_effective_msvc_runtime(_CRT)
    else()
        set(_CRT not-applicable)
    endif()
    if(CMAKE_CONFIGURATION_TYPES)
        set(_CONFIGURATIONS "${CMAKE_CONFIGURATION_TYPES}")
    elseif(CMAKE_BUILD_TYPE)
        set(_CONFIGURATIONS "${CMAKE_BUILD_TYPE}")
    else()
        set(_CONFIGURATIONS NOCONFIG)
    endif()
    set(_info "# Relocatable package build identity; no source or machine paths.\nset(SMROBOT_BUILDINFO_FORMAT 1)\n")
    foreach(_field IN LISTS _fields)
        string(APPEND _info "set(SMROBOT_BUILDINFO_${_field} [==[${_${_field}}]==])\n")
    endforeach()
    set(_file "${CMAKE_CURRENT_BINARY_DIR}/cmake/${package}BuildInfo.cmake")
    file(WRITE "${_file}" "${_info}")
    install(FILES "${_file}" DESTINATION "${package}/lib/cmake"
        COMPONENT "smrobot_sdk_${package}_package")
endfunction()

function(rs_validate_package_build_info package package_root)
    set(_file "${package_root}/lib/cmake/${package}BuildInfo.cmake")
    if(NOT EXISTS "${_file}")
        if(SMROBOT_PREBUILT_REQUIRE_BUILD_METADATA)
            message(FATAL_ERROR "[PrebuiltIdentity] ${package} lacks ${package}BuildInfo.cmake. Rebuild/install this package or explicitly allow legacy metadata.")
        endif()
        message(WARNING "[PrebuiltIdentity] Legacy ${package} has no build identity; compiler/CRT identity is unverified. Set SMROBOT_PREBUILT_REQUIRE_BUILD_METADATA=ON for strict consumption.")
        return()
    endif()
    foreach(_field FORMAT PACKAGE VERSION SYSTEM ARCHITECTURE POINTER_SIZE COMPILER_ID COMPILER_VERSION TOOLSET CRT CONFIGURATIONS)
        unset(SMROBOT_BUILDINFO_${_field})
    endforeach()
    include("${_file}")
    if(NOT SMROBOT_BUILDINFO_FORMAT STREQUAL "1" OR
       NOT SMROBOT_BUILDINFO_PACKAGE STREQUAL "${package}" OR
       NOT SMROBOT_BUILDINFO_VERSION STREQUAL "${SMROBOT_PREBUILT_EXPECTED_VERSION}")
        message(FATAL_ERROR "[PrebuiltIdentity] Invalid package/version build identity for ${package}")
    endif()
    foreach(_field PACKAGE VERSION SYSTEM ARCHITECTURE POINTER_SIZE COMPILER_ID COMPILER_VERSION CRT CONFIGURATIONS)
        if(NOT DEFINED SMROBOT_BUILDINFO_${_field} OR "${SMROBOT_BUILDINFO_${_field}}" STREQUAL "")
            message(FATAL_ERROR "[PrebuiltIdentity] Incomplete build identity: ${_field}")
        endif()
    endforeach()
    rs_build_architecture(_architecture)
    if(NOT SMROBOT_BUILDINFO_ARCHITECTURE STREQUAL "${_architecture}" OR
       NOT SMROBOT_BUILDINFO_SYSTEM STREQUAL "${CMAKE_SYSTEM_NAME}" OR
       NOT SMROBOT_BUILDINFO_POINTER_SIZE STREQUAL "${CMAKE_SIZEOF_VOID_P}")
        message(FATAL_ERROR "[PrebuiltIdentity] System/architecture mismatch for ${package}")
    endif()
    if(NOT SMROBOT_BUILDINFO_COMPILER_ID STREQUAL "${CMAKE_CXX_COMPILER_ID}")
        message(FATAL_ERROR "[PrebuiltIdentity] Compiler family mismatch for ${package}")
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        rs_effective_msvc_runtime(_runtime)
        if(NOT SMROBOT_BUILDINFO_TOOLSET STREQUAL "${MSVC_TOOLSET_VERSION}" OR
           NOT SMROBOT_BUILDINFO_CRT STREQUAL "${_runtime}")
            message(FATAL_ERROR "[PrebuiltIdentity] MSVC toolset/CRT mismatch for ${package}")
        endif()
    else()
        string(REGEX MATCH "^[0-9]+[.][0-9]+" _consumer_version "${CMAKE_CXX_COMPILER_VERSION}")
        string(REGEX MATCH "^[0-9]+[.][0-9]+" _producer_version "${SMROBOT_BUILDINFO_COMPILER_VERSION}")
        if(NOT _consumer_version STREQUAL _producer_version)
            message(FATAL_ERROR "[PrebuiltIdentity] Compiler version family mismatch for ${package}")
        endif()
    endif()
    foreach(_config IN LISTS SMROBOT_PREBUILT_REQUIRED_CONFIGURATIONS)
        if(NOT _config IN_LIST SMROBOT_BUILDINFO_CONFIGURATIONS AND
           NOT "NOCONFIG" IN_LIST SMROBOT_BUILDINFO_CONFIGURATIONS)
            message(FATAL_ERROR "[PrebuiltIdentity] ${package} was not configured for ${_config}")
        endif()
    endforeach()
endfunction()

function(rs_validate_imported_package_targets package package_root)
    foreach(_component IN LISTS ARGN)
        set(_target "${package}::${_component}")
        if(NOT TARGET "${_target}")
            message(FATAL_ERROR "[PrebuiltIdentity] Missing requested target ${_target}")
        endif()
        get_target_property(_alias "${_target}" ALIASED_TARGET)
        if(_alias)
            set(_target "${_alias}")
        endif()
        get_target_property(_type "${_target}" TYPE)
        get_target_property(_imported "${_target}" IMPORTED)
        if(NOT _imported)
            message(FATAL_ERROR "[PrebuiltIdentity] ${_target} is already supplied from source")
        endif()
        if(_type STREQUAL "INTERFACE_LIBRARY")
            continue()
        endif()
        foreach(_config IN LISTS SMROBOT_PREBUILT_REQUIRED_CONFIGURATIONS)
            string(TOUPPER "${_config}" _upper)
            get_property(_has_mapping TARGET "${_target}" PROPERTY MAP_IMPORTED_CONFIG_${_upper} SET)
            get_target_property(_mapping "${_target}" MAP_IMPORTED_CONFIG_${_upper})
            if(_has_mapping)
                if("${_mapping}" STREQUAL "")
                    set(_candidates __GENERIC)
                else()
                    set(_candidates ${_mapping})
                endif()
            else()
                set(_candidates "${_upper}" NOCONFIG __GENERIC)
            endif()
            set(_location "")
            set(_implib "")
            set(_resolved_upper "${_upper}")
            foreach(_candidate IN LISTS _candidates)
                string(TOUPPER "${_candidate}" _candidate)
                if(_candidate STREQUAL "__GENERIC")
                    set(_suffix "")
                else()
                    set(_suffix "_${_candidate}")
                endif()
                get_target_property(_candidate_location "${_target}" IMPORTED_LOCATION${_suffix})
                if(_candidate_location AND NOT _candidate_location MATCHES "-NOTFOUND$")
                    set(_location "${_candidate_location}")
                    get_target_property(_implib "${_target}" IMPORTED_IMPLIB${_suffix})
                    if(NOT _candidate STREQUAL "__GENERIC" AND NOT _candidate STREQUAL "NOCONFIG")
                        set(_resolved_upper "${_candidate}")
                    endif()
                    break()
                endif()
            endforeach()
            if(NOT _location OR _location MATCHES "-NOTFOUND$" OR NOT EXISTS "${_location}")
                message(FATAL_ERROR "[PrebuiltIdentity] ${_target} lacks ${_config} runtime/link artifact: ${_location}")
            endif()
            rs_check_path_within("${package_root}" "${_location}" "${_target} ${_config} artifact")
            if(WIN32 AND _type STREQUAL "SHARED_LIBRARY")
                if(NOT _implib OR _implib MATCHES "-NOTFOUND$" OR NOT EXISTS "${_implib}")
                    message(FATAL_ERROR "[PrebuiltIdentity] ${_target} lacks ${_config} import library")
                endif()
                rs_check_path_within("${package_root}" "${_implib}" "${_target} ${_config} import library")
            endif()
            get_filename_component(_runtime_dir "${_location}" DIRECTORY)
            get_target_property(_private "${_target}" SMROBOT_PRIVATE_RUNTIME_DLLS_${_resolved_upper})
            if(_private AND NOT _private MATCHES "-NOTFOUND$")
                foreach(_dll IN LISTS _private)
                    if(IS_ABSOLUTE "${_dll}" OR _dll MATCHES "[/\\]")
                        message(FATAL_ERROR "[PrebuiltIdentity] Non-relocatable private runtime name: ${_dll}")
                    endif()
                    if(NOT EXISTS "${_runtime_dir}/${_dll}")
                        message(FATAL_ERROR "[PrebuiltIdentity] ${_target} missing private ${_config} runtime ${_dll}")
                    endif()
                endforeach()
            endif()
        endforeach()
    endforeach()
endfunction()
