function(rs2026_catalog_entry)
    cmake_parse_arguments(ENTRY ""
        "PATH;PACKAGE;COMPONENT;CATEGORY;SUBMODULE;STATUS;ORIGIN;COST;REVIEWER;REVIEWED_ON;CONTRACT_ID;CONTRACT_FILE;FAILURE_EVIDENCE"
        "" ${ARGN})
    foreach(_field PATH PACKAGE COMPONENT CATEGORY STATUS ORIGIN COST)
        if(NOT ENTRY_${_field})
            message(FATAL_ERROR "Test catalog entry is missing ${_field}: ${ARGN}")
        endif()
    endforeach()
    if(NOT EXISTS "${CMAKE_SOURCE_DIR}/${ENTRY_PATH}/CMakeLists.txt")
        message(FATAL_ERROR "Test catalog path does not exist: ${ENTRY_PATH}")
    endif()
    if(NOT ENTRY_STATUS MATCHES "^(curated|candidate|unreviewed|retired)$")
        message(FATAL_ERROR "Invalid test status for ${ENTRY_PATH}: ${ENTRY_STATUS}")
    endif()
    if(NOT ENTRY_CATEGORY MATCHES "^(Regression|Integration|Smoke|BuildChecks|Governance)$")
        message(FATAL_ERROR "Invalid test category for ${ENTRY_PATH}: ${ENTRY_CATEGORY}")
    endif()
    if(NOT ENTRY_ORIGIN MATCHES "^(human|ai|unknown)$")
        message(FATAL_ERROR "Invalid test origin for ${ENTRY_PATH}: ${ENTRY_ORIGIN}")
    endif()
    if(NOT ENTRY_COST MATCHES "^(fast|normal|slow)$")
        message(FATAL_ERROR "Invalid test cost for ${ENTRY_PATH}: ${ENTRY_COST}")
    endif()
    if(ENTRY_STATUS STREQUAL "candidate" AND NOT ENTRY_CONTRACT_FILE)
        message(FATAL_ERROR
            "Candidate test requires a behavior contract or purpose file: ${ENTRY_PATH}")
    endif()
    if(ENTRY_CONTRACT_FILE AND
       NOT EXISTS "${CMAKE_SOURCE_DIR}/${ENTRY_CONTRACT_FILE}")
        message(FATAL_ERROR "Test contract does not exist: ${ENTRY_CONTRACT_FILE}")
    endif()
    if(ENTRY_STATUS STREQUAL "curated")
        if(NOT ENTRY_REVIEWER OR NOT ENTRY_REVIEWED_ON OR
           NOT ENTRY_CONTRACT_ID OR NOT ENTRY_CONTRACT_FILE OR
           NOT ENTRY_FAILURE_EVIDENCE)
            message(FATAL_ERROR
                "Curated test requires human reviewer, review date, contract, and failure evidence: ${ENTRY_PATH}")
        endif()
    endif()
    string(MD5 _key "${ENTRY_PATH}")
    get_property(_existing GLOBAL PROPERTY "RS2026_TEST_${_key}_PATH")
    if(_existing)
        message(FATAL_ERROR "Duplicate test catalog path: ${ENTRY_PATH}")
    endif()
    get_property(_paths GLOBAL PROPERTY RS2026_TEST_CATALOG_PATHS)
    list(APPEND _paths "${ENTRY_PATH}")
    set_property(GLOBAL PROPERTY RS2026_TEST_CATALOG_PATHS "${_paths}")
    foreach(_field PATH PACKAGE COMPONENT CATEGORY SUBMODULE STATUS ORIGIN COST
                   REVIEWER REVIEWED_ON CONTRACT_ID CONTRACT_FILE FAILURE_EVIDENCE)
        set_property(GLOBAL PROPERTY "RS2026_TEST_${_key}_${_field}" "${ENTRY_${_field}}")
    endforeach()
endfunction()

include("${CMAKE_CURRENT_LIST_DIR}/RS2026TestCatalog.cmake")

function(_rs2026_test_canonical_owner _out _package _component)
    set(_owner_component "${_component}")
    if(_package STREQUAL "SMRobotApps" AND
       _component STREQUAL "RobotQtModulesShared")
        set(_owner_component RobotQtModules)
    elseif(_package STREQUAL "SMRobotWorkbenchCollisionConfig" AND
           _component STREQUAL "CollisionLinkModelSetup")
        set(_owner_component CollisionConfigWorkbench)
    elseif(_package STREQUAL "SMRobotWorkbenchProjectAssembly" AND
           _component STREQUAL "SceneExplorer")
        set(_owner_component ProjectAssemblyWorkbench)
    endif()
    set(${_out} "${_package}/${_owner_component}" PARENT_SCOPE)
endfunction()

function(_rs2026_compute_impacted_owners)
    if(NOT RS2026_TEST_IMPACT_KIND MATCHES "^(LOCAL|PUBLIC_API|SCHEMA|BUILD|RUNTIME)$")
        message(FATAL_ERROR "Invalid RS2026_TEST_IMPACT_KIND: ${RS2026_TEST_IMPACT_KIND}")
    endif()
    if(RS2026_TEST_PACKAGE STREQUAL "BuildSystem" OR
       NOT RS2026_TEST_IMPACT_KIND STREQUAL "LOCAL")
        set_property(GLOBAL PROPERTY RS2026_IMPACTED_OWNERS "ALL")
        message(STATUS
            "[TestSelection] IMPACTED ${RS2026_TEST_IMPACT_KIND} requires all available tests; SDK/ABI/release gates remain separate")
        return()
    endif()
    _rs2026_test_canonical_owner(_seed
        "${RS2026_TEST_PACKAGE}" "${RS2026_TEST_COMPONENT}")
    set(_available)
    foreach(_package IN LISTS AllBuildPackages)
        foreach(_component IN LISTS RS2026_SOURCE_COMPONENTS_${_package})
            list(APPEND _available "${_package}/${_component}")
        endforeach()
    endforeach()
    if(NOT _seed IN_LIST _available)
        message(FATAL_ERROR
            "IMPACTED owner ${_seed} is not an enabled source component in this profile")
    endif()

    set(_owners "${_seed}")
    set(_expanded ON)
    while(_expanded)
        set(_expanded OFF)
        foreach(_package IN LISTS AllBuildPackages)
            foreach(_component IN LISTS RS2026_SOURCE_COMPONENTS_${_package})
                set(_consumer "${_package}/${_component}")
                if(_consumer IN_LIST _owners)
                    continue()
                endif()
                set(_requirements
                    ${${_package}${_component}_RequiredLibsPublic}
                    ${${_package}${_component}_RequiredLibsPrivate})
                foreach(_raw IN LISTS _requirements)
                    _rs_normalize_dependency("${_raw}" _dependency _state)
                    if(NOT _state STREQUAL "VALID")
                        continue()
                    endif()
                    string(REPLACE "::" ";" _parts "${_dependency}")
                    list(GET _parts 0 _dependency_package)
                    list(GET _parts 1 _dependency_component)
                    rs_source_dependency_owner(
                        "${_dependency_package}" "${_dependency_component}"
                        _owner_package _owner_component)
                    if("${_owner_package}/${_owner_component}" IN_LIST _owners)
                        list(APPEND _owners "${_consumer}")
                        set(_expanded ON)
                        break()
                    endif()
                endforeach()
            endforeach()
        endforeach()
    endwhile()
    set_property(GLOBAL PROPERTY RS2026_IMPACTED_OWNERS "${_owners}")
    message(STATUS "[TestSelection] IMPACTED source owner closure: ${_owners}")
    if(_seed STREQUAL "SMRobotPlatform/SimulationProject")
        set(_required_consumers
            SMRobotPlatform/SimulationRuntime
            SMRobotPlatform/ProjectSimulationSDK
            SMRobotApps/RobotViewerCore
            SMRobotApps/RobotQtViewer)
    elseif(_seed STREQUAL "SMRobotCore/Collision")
        set(_required_consumers
            SMRobotPlatform/SimulationRuntime
            SMRobotPlatform/RobotRenderBridge
            SMRobotApps/RobotViewerCore
            SMRobotApps/RobotQtViewer)
    endif()
    foreach(_consumer IN LISTS _required_consumers)
        if(_consumer IN_LIST _available AND NOT _consumer IN_LIST _owners)
            message(FATAL_ERROR
                "IMPACTED dependency metadata lost required consumer ${_seed} -> ${_consumer}")
        endif()
    endforeach()
endfunction()

function(rs2026_test_unit_selected _out _path)
    if(NOT BUILD_TESTING)
        set(${_out} OFF PARENT_SCOPE)
        return()
    endif()
    string(MD5 _key "${_path}")
    get_property(_known GLOBAL PROPERTY "RS2026_TEST_${_key}_PATH")
    if(NOT _known STREQUAL _path)
        message(FATAL_ERROR "Uncataloged test directory: ${_path}")
    endif()
    get_property(_status GLOBAL PROPERTY "RS2026_TEST_${_key}_STATUS")
    get_property(_cost GLOBAL PROPERTY "RS2026_TEST_${_key}_COST")
    get_property(_package GLOBAL PROPERTY "RS2026_TEST_${_key}_PACKAGE")
    get_property(_component GLOBAL PROPERTY "RS2026_TEST_${_key}_COMPONENT")
    get_property(_submodule GLOBAL PROPERTY "RS2026_TEST_${_key}_SUBMODULE")
    set(_selected OFF)
    if(_status STREQUAL "curated" AND RS2026_TEST_INCLUDE_CURATED)
        set(_selected ON)
    elseif(_status STREQUAL "candidate" AND RS2026_TEST_INCLUDE_CANDIDATE)
        set(_selected ON)
    elseif(_status STREQUAL "unreviewed" AND RS2026_TEST_INCLUDE_UNREVIEWED)
        set(_selected ON)
    endif()
    get_property(_impact_owners GLOBAL PROPERTY RS2026_IMPACTED_OWNERS)
    if(_cost STREQUAL "slow" AND NOT RS2026_TEST_INCLUDE_SLOW
       AND NOT RS2026_TEST_SCOPE STREQUAL "FULL" AND
       NOT _impact_owners STREQUAL "ALL")
        set(_selected OFF)
    endif()
    if(RS2026_TEST_SCOPE STREQUAL "SELECTED")
        if(NOT TestPackage_${_package} OR NOT Test${_package}_${_component})
            set(_selected OFF)
        endif()
    elseif(RS2026_TEST_SCOPE STREQUAL "COMPONENT")
        if(NOT _package STREQUAL RS2026_TEST_PACKAGE
           OR NOT _component STREQUAL RS2026_TEST_COMPONENT)
            set(_selected OFF)
        endif()
    elseif(RS2026_TEST_SCOPE STREQUAL "IMPACTED")
        get_property(_owners GLOBAL PROPERTY RS2026_IMPACTED_OWNERS)
        if(NOT _owners STREQUAL "ALL" AND
           NOT RS2026_TEST_PACKAGE STREQUAL "BuildSystem")
            _rs2026_test_canonical_owner(_owner "${_package}" "${_component}")
            if(NOT _owner IN_LIST _owners)
                set(_selected OFF)
            endif()
        endif()
    elseif(RS2026_TEST_SCOPE STREQUAL "PACKAGE")
        if(NOT _package STREQUAL RS2026_TEST_PACKAGE)
            set(_selected OFF)
        endif()
    endif()
    if(RS2026_TEST_SUBMODULE AND NOT _submodule STREQUAL RS2026_TEST_SUBMODULE)
        set(_selected OFF)
    endif()
    set(${_out} ${_selected} PARENT_SCOPE)
endfunction()

function(rs2026_test_subtree_selected _out _source_dir)
    file(RELATIVE_PATH _relative "${CMAKE_SOURCE_DIR}" "${_source_dir}")
    file(TO_CMAKE_PATH "${_relative}" _relative)
    get_property(_paths GLOBAL PROPERTY RS2026_TEST_CATALOG_PATHS)
    set(_selected OFF)
    foreach(_path IN LISTS _paths)
        string(FIND "${_path}/" "${_relative}/" _prefix_index)
        if(_prefix_index EQUAL 0)
            rs2026_test_unit_selected(_unit_selected "${_path}")
            if(_unit_selected)
                set(_selected ON)
                break()
            endif()
        endif()
    endforeach()
    set(${_out} ${_selected} PARENT_SCOPE)
endfunction()

function(rs2026_add_test_unit _source)
    get_filename_component(_absolute "${CMAKE_CURRENT_SOURCE_DIR}/${_source}" ABSOLUTE)
    file(RELATIVE_PATH _relative "${CMAKE_SOURCE_DIR}" "${_absolute}")
    file(TO_CMAKE_PATH "${_relative}" _relative)
    rs2026_test_unit_selected(_selected "${_relative}")
    if(NOT _selected)
        return()
    endif()
    string(MD5 _binary_key "${_relative}")
    string(SUBSTRING "${_binary_key}" 0 10 _short_key)
    get_property(_previous GLOBAL PROPERTY "RS2026_TEST_BINARY_${_short_key}")
    if(_previous AND NOT _previous STREQUAL _relative)
        message(FATAL_ERROR
            "Test binary directory key collision: ${_previous} and ${_relative}")
    endif()
    set_property(GLOBAL PROPERTY "RS2026_TEST_BINARY_${_short_key}" "${_relative}")
    add_subdirectory("${_source}" "${CMAKE_BINARY_DIR}/t/${_short_key}")
    string(MD5 _key "${_relative}")
    get_property(_status GLOBAL PROPERTY "RS2026_TEST_${_key}_STATUS")
    set_property(GLOBAL APPEND PROPERTY RS2026_ACTIVE_TEST_PATHS "${_relative}")
    get_property(_binary DIRECTORY "${_absolute}" PROPERTY BINARY_DIR)
    get_property(_targets DIRECTORY "${_absolute}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(_package GLOBAL PROPERTY "RS2026_TEST_${_key}_PACKAGE")
    get_property(_component GLOBAL PROPERTY "RS2026_TEST_${_key}_COMPONENT")
    get_property(_category GLOBAL PROPERTY "RS2026_TEST_${_key}_CATEGORY")
    foreach(_target IN LISTS _targets)
        set_target_properties(${_target} PROPERTIES
            FOLDER "Tests/${_package}/${_component}/${_category}")
    endforeach()
    get_property(_dirs GLOBAL PROPERTY RS2026_SELECTED_TEST_DIRS)
    get_property(_all_targets GLOBAL PROPERTY RS2026_SELECTED_TEST_TARGETS)
    list(APPEND _dirs "${_binary}")
    list(APPEND _all_targets ${_targets})
    set_property(GLOBAL PROPERTY RS2026_SELECTED_TEST_DIRS "${_dirs}")
    set_property(GLOBAL PROPERTY RS2026_SELECTED_TEST_TARGETS "${_all_targets}")
    get_property(_status_dirs GLOBAL PROPERTY "RS2026_SELECTED_TEST_DIRS_${_status}")
    get_property(_status_targets GLOBAL PROPERTY "RS2026_SELECTED_TEST_TARGETS_${_status}")
    list(APPEND _status_dirs "${_binary}")
    list(APPEND _status_targets ${_targets})
    set_property(GLOBAL PROPERTY "RS2026_SELECTED_TEST_DIRS_${_status}" "${_status_dirs}")
    set_property(GLOBAL PROPERTY "RS2026_SELECTED_TEST_TARGETS_${_status}" "${_status_targets}")
    message(STATUS "[TestSelection] ${_status}: ${_relative}")
endfunction()

function(rs2026_validate_test_catalog)
    get_property(_catalog GLOBAL PROPERTY RS2026_TEST_CATALOG_PATHS)
    file(GLOB_RECURSE _cmake_files CONFIGURE_DEPENDS RELATIVE "${CMAKE_SOURCE_DIR}"
        "${CMAKE_SOURCE_DIR}/Common/*/CMakeLists.txt"
        "${CMAKE_SOURCE_DIR}/SMRobotCore/*/CMakeLists.txt"
        "${CMAKE_SOURCE_DIR}/SMRobotPlatform/*/CMakeLists.txt"
        "${CMAKE_SOURCE_DIR}/SMRobotApps/*/CMakeLists.txt"
        "${CMAKE_SOURCE_DIR}/SMRobotMotionPlanning/*/CMakeLists.txt"
        "${CMAKE_SOURCE_DIR}/SMRobotSpray/*/CMakeLists.txt"
        "${CMAKE_SOURCE_DIR}/SimWorkbench/*/CMakeLists.txt"
        "${CMAKE_SOURCE_DIR}/tests/*/CMakeLists.txt")
    foreach(_file IN LISTS _cmake_files)
        file(TO_CMAKE_PATH "${_file}" _file)
        if(_file MATCHES "/regression/.+/CMakeLists.txt$")
            string(REGEX REPLACE "/CMakeLists.txt$" "" _unit "${_file}")
            if(NOT _unit IN_LIST _catalog)
                message(FATAL_ERROR
                    "Uncataloged regression test directory: ${_unit}. Register it in cmake/RS2026TestCatalog.cmake")
            endif()
        elseif(_file MATCHES "^tests/.+/CMakeLists.txt$" AND
               NOT _file MATCHES "^tests/prebuilt_external_validation/" AND
               NOT _file STREQUAL "tests/cmake_build_revision/ProfileFixture/CMakeLists.txt")
            string(REGEX REPLACE "/CMakeLists.txt$" "" _unit "${_file}")
            if(NOT _unit IN_LIST _catalog)
                message(FATAL_ERROR
                    "Uncataloged project test directory: ${_unit}. Register it in cmake/RS2026TestCatalog.cmake")
            endif()
        endif()
    endforeach()
endfunction()

function(_rs2026_collect_configured_ctest_rows _directory)
    file(RELATIVE_PATH _relative "${CMAKE_SOURCE_DIR}" "${_directory}")
    file(TO_CMAKE_PATH "${_relative}" _relative)
    get_property(_tests DIRECTORY "${_directory}" PROPERTY TESTS)
    get_property(_paths GLOBAL PROPERTY RS2026_TEST_CATALOG_PATHS)
    foreach(_test IN LISTS _tests)
        foreach(_path IN LISTS _paths)
            string(FIND "${_relative}/" "${_path}/" _prefix_index)
            if(_prefix_index EQUAL 0)
                set_property(GLOBAL APPEND_STRING PROPERTY RS2026_CONFIGURED_CTEST_ROWS
                    "| `${_test}` | `${_path}` |\n")
                get_property(_count GLOBAL PROPERTY RS2026_CONFIGURED_CTEST_COUNT)
                math(EXPR _count "${_count} + 1")
                set_property(GLOBAL PROPERTY RS2026_CONFIGURED_CTEST_COUNT ${_count})
                break()
            endif()
        endforeach()
    endforeach()
    get_property(_children DIRECTORY "${_directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        _rs2026_collect_configured_ctest_rows("${_child}")
    endforeach()
endfunction()

function(_rs2026_write_test_catalog_report)
    set(_report "${CMAKE_BINARY_DIR}/RS2026TestCatalog.md")
    get_property(_paths GLOBAL PROPERTY RS2026_TEST_CATALOG_PATHS)
    set(_curated 0)
    set(_candidate 0)
    set(_unreviewed 0)
    set(_retired 0)
    set(_rows)
    foreach(_path IN LISTS _paths)
        string(MD5 _key "${_path}")
        foreach(_field PACKAGE COMPONENT CATEGORY STATUS ORIGIN COST CONTRACT_FILE
                       REVIEWER REVIEWED_ON FAILURE_EVIDENCE)
            get_property(_${_field} GLOBAL PROPERTY "RS2026_TEST_${_key}_${_field}")
            if(NOT _${_field})
                set(_${_field} "(none)")
            endif()
        endforeach()
        math(EXPR _${_STATUS} "${_${_STATUS}} + 1")
        string(APPEND _rows
            "| `${_PACKAGE}/${_COMPONENT}` | `${_CATEGORY}` | `${_STATUS}` | `${_ORIGIN}` | `${_COST}` | `${_path}` | `${_CONTRACT_FILE}` | `${_REVIEWER}` / `${_REVIEWED_ON}` | `${_FAILURE_EVIDENCE}` |\n")
    endforeach()
    set_property(GLOBAL PROPERTY RS2026_CONFIGURED_CTEST_ROWS "")
    set_property(GLOBAL PROPERTY RS2026_CONFIGURED_CTEST_COUNT 0)
    _rs2026_collect_configured_ctest_rows("${CMAKE_SOURCE_DIR}")
    get_property(_ctest_rows GLOBAL PROPERTY RS2026_CONFIGURED_CTEST_ROWS)
    get_property(_ctest_count GLOBAL PROPERTY RS2026_CONFIGURED_CTEST_COUNT)
    file(WRITE "${_report}"
        "# RS2026 test catalog\n\nGenerated by CMake Configure. Each row is a test directory, not a CTest case.\n"
        "To change a directory's status or owner, search its path in `cmake/RS2026TestCatalog.cmake`.\n\n"
        "| Curated | Candidate | Unreviewed | Retired |\n|---:|---:|---:|---:|\n"
        "| ${_curated} | ${_candidate} | ${_unreviewed} | ${_retired} |\n\n"
        "| Owner | Category | Status | Origin | Cost | Test directory | Contract file | Reviewer / date | Failure evidence |\n"
        "|---|---|---|---|---|---|---|---|---|\n${_rows}"
        "\n## CTest names registered in this configure (${_ctest_count})\n\n"
        "Only configured test directories appear below. Build-time discovered GoogleTest cases are not listed here; use `ctest -N` after building to see them.\n\n"
        "| CTest name | Catalog test directory |\n|---|---|\n${_ctest_rows}")
    message(STATUS "[TestSelection] Catalog report: ${_report}")
endfunction()

function(_rs2026_validate_registered_test_dirs _directory)
    get_property(_tests DIRECTORY "${_directory}" PROPERTY TESTS)
    if(_tests)
        file(RELATIVE_PATH _relative "${CMAKE_SOURCE_DIR}" "${_directory}")
        file(TO_CMAKE_PATH "${_relative}" _relative)
        if(_relative STREQUAL "" OR _relative STREQUAL ".")
            foreach(_test IN LISTS _tests)
                if(NOT _test STREQUAL "SoftwareArchitecture-BoundaryCheck")
                    message(FATAL_ERROR "Uncataloged root CTest: ${_test}")
                endif()
            endforeach()
        else()
            get_property(_active GLOBAL PROPERTY RS2026_ACTIVE_TEST_PATHS)
            set(_governed OFF)
            foreach(_path IN LISTS _active)
                string(FIND "${_relative}/" "${_path}/" _prefix_index)
                if(_prefix_index EQUAL 0)
                    set(_governed ON)
                    break()
                endif()
            endforeach()
            if(NOT _governed)
                message(FATAL_ERROR
                    "CTest registered outside selected test units: ${_relative}: ${_tests}")
            endif()
        endif()
    endif()
    get_property(_children DIRECTORY "${_directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        _rs2026_validate_registered_test_dirs("${_child}")
    endforeach()
endfunction()

function(_rs2026_write_test_selection_report)
    set(_report "${CMAKE_BINARY_DIR}/RS2026TestSelection.md")
    get_property(_active GLOBAL PROPERTY RS2026_ACTIVE_TEST_PATHS)
    list(LENGTH _active _count)
    file(WRITE "${_report}"
        "# RS2026 selected tests\n\nGenerated by CMake Configure.\n\n"
        "- Scope: `${RS2026_TEST_SCOPE}`\n"
        "- Selected test directories: **${_count}**\n")
    if(RS2026_TEST_SCOPE STREQUAL "SELECTED")
        file(APPEND "${_report}"
            "- Owner selection: `TestPackage_<Package>` and `Test<Package>_<Component>` cache options. `Test_Package` and `Test_Component` are ignored in this scope.\n"
            "\n## Owner options\n\n"
            "A component value is saved while its package option is off. The effective column shows owner selection; governance and cost filters apply afterward.\n\n"
            "| Package option | Component option | Package | Component saved | Effective |\n"
            "|---|---|---|---|---|\n")
        get_property(_option_paths GLOBAL PROPERTY RS2026_TEST_CATALOG_PATHS)
        set(_reported_owners)
        foreach(_option_path IN LISTS _option_paths)
            string(MD5 _option_key "${_option_path}")
            get_property(_option_package GLOBAL PROPERTY "RS2026_TEST_${_option_key}_PACKAGE")
            get_property(_option_component GLOBAL PROPERTY "RS2026_TEST_${_option_key}_COMPONENT")
            set(_option_owner "${_option_package}/${_option_component}")
            if(_option_owner IN_LIST _reported_owners)
                continue()
            endif()
            list(APPEND _reported_owners "${_option_owner}")
            if(TestPackage_${_option_package})
                set(_package_enabled ON)
            else()
                set(_package_enabled OFF)
            endif()
            if(Test${_option_package}_${_option_component})
                set(_component_enabled ON)
            else()
                set(_component_enabled OFF)
            endif()
            if(_package_enabled AND _component_enabled)
                set(_option_effective ON)
            else()
                set(_option_effective OFF)
            endif()
            file(APPEND "${_report}"
                "| `TestPackage_${_option_package}` | `Test${_option_package}_${_option_component}` | ${_package_enabled} | ${_component_enabled} | ${_option_effective} |\n")
        endforeach()
        file(APPEND "${_report}" "\n")
    else()
        file(APPEND "${_report}"
            "- Package: `${RS2026_TEST_PACKAGE}`\n"
            "- Component: `${RS2026_TEST_COMPONENT}`\n")
    endif()
    if(DEFINED RS2026_LICENSE_ENFORCEMENT_MODE)
        file(APPEND "${_report}"
            "- License enforcement mode: `${RS2026_LICENSE_ENFORCEMENT_MODE}`. Authorization tests require a matching host license and their expected enforcement mode.\n")
    endif()
    if(RS2026_TEST_SCOPE STREQUAL "IMPACTED")
        get_property(_owners GLOBAL PROPERTY RS2026_IMPACTED_OWNERS)
        file(APPEND "${_report}"
            "\n- Impact kind: `${RS2026_TEST_IMPACT_KIND}`\n"
            "- Impacted source owner closure: `${_owners}`\n"
            "- SDK, ABI, installed consumer, and release gates are separate.\n")
    endif()
    file(APPEND "${_report}"
        "\n| Owner | Category | Governance status | Origin | Cost | Test directory |\n"
        "|---|---|---|---|---|---|\n")
    foreach(_path IN LISTS _active)
        string(MD5 _key "${_path}")
        foreach(_field PACKAGE COMPONENT CATEGORY STATUS ORIGIN COST)
            get_property(_${_field} GLOBAL PROPERTY "RS2026_TEST_${_key}_${_field}")
        endforeach()
        _rs2026_test_canonical_owner(_covered_owner "${_PACKAGE}" "${_COMPONENT}")
        list(APPEND _covered_owners "${_covered_owner}")
        file(APPEND "${_report}"
            "| `${_PACKAGE}/${_COMPONENT}` | `${_CATEGORY}` | `${_STATUS}` | `${_ORIGIN}` | `${_COST}` | `${_path}` |\n")
    endforeach()
    get_property(_catalog GLOBAL PROPERTY RS2026_TEST_CATALOG_PATHS)
    file(APPEND "${_report}"
        "\n## Excluded catalog entries\n\n"
        "This list describes the current scope, governance switches, cost switch, and enabled build profile.\n\n"
        "| Test directory | Exclusion reason |\n"
        "|---|---|\n")
    set(_excluded_count 0)
    foreach(_path IN LISTS _catalog)
        if(_path IN_LIST _active)
            continue()
        endif()
        math(EXPR _excluded_count "${_excluded_count} + 1")
        string(MD5 _key "${_path}")
        foreach(_field PACKAGE COMPONENT SUBMODULE STATUS COST)
            get_property(_${_field} GLOBAL PROPERTY "RS2026_TEST_${_key}_${_field}")
        endforeach()
        rs2026_test_unit_selected(_eligible "${_path}")
        if(_eligible)
            set(_reason "owner not enabled in the current build profile")
        elseif(_STATUS STREQUAL "retired")
            set(_reason "retired")
        elseif((_STATUS STREQUAL "curated" AND NOT RS2026_TEST_INCLUDE_CURATED) OR
               (_STATUS STREQUAL "candidate" AND NOT RS2026_TEST_INCLUDE_CANDIDATE) OR
               (_STATUS STREQUAL "unreviewed" AND NOT RS2026_TEST_INCLUDE_UNREVIEWED))
            set(_reason "governance status `${_STATUS}` disabled")
        elseif(_COST STREQUAL "slow" AND NOT RS2026_TEST_INCLUDE_SLOW AND
               NOT RS2026_TEST_SCOPE STREQUAL "FULL" AND
               NOT _owners STREQUAL "ALL")
            set(_reason "slow cost disabled")
        elseif(RS2026_TEST_SCOPE STREQUAL "SELECTED" AND
               NOT TestPackage_${_PACKAGE})
            set(_reason "test package option disabled")
        elseif(RS2026_TEST_SCOPE STREQUAL "SELECTED" AND
               NOT Test${_PACKAGE}_${_COMPONENT})
            set(_reason "test component option disabled")
        elseif(RS2026_TEST_SCOPE STREQUAL "COMPONENT" AND
               (NOT _PACKAGE STREQUAL RS2026_TEST_PACKAGE OR
                NOT _COMPONENT STREQUAL RS2026_TEST_COMPONENT))
            set(_reason "outside selected component")
        elseif(RS2026_TEST_SCOPE STREQUAL "PACKAGE" AND
               NOT _PACKAGE STREQUAL RS2026_TEST_PACKAGE)
            set(_reason "outside selected package")
        elseif(RS2026_TEST_SCOPE STREQUAL "IMPACTED" AND
               NOT _owners STREQUAL "ALL")
            _rs2026_test_canonical_owner(_owner "${_PACKAGE}" "${_COMPONENT}")
            if(NOT _owner IN_LIST _owners)
                set(_reason "outside impacted consumer closure")
            else()
                set(_reason "owner not enabled in the current build profile")
            endif()
        elseif(RS2026_TEST_SUBMODULE AND
               NOT _SUBMODULE STREQUAL RS2026_TEST_SUBMODULE)
            set(_reason "outside selected submodule")
        else()
            set(_reason "not registered by this build profile")
        endif()
        file(APPEND "${_report}" "| `${_path}` | ${_reason} |\n")
    endforeach()
    file(APPEND "${_report}" "\nExcluded catalog directories: **${_excluded_count}**.\n")
    if(RS2026_TEST_SCOPE STREQUAL "IMPACTED" AND NOT _owners STREQUAL "ALL")
        set(_uncovered)
        foreach(_owner IN LISTS _owners)
            if(NOT _owner IN_LIST _covered_owners)
                list(APPEND _uncovered "${_owner}")
            endif()
        endforeach()
        file(APPEND "${_report}"
            "\nSource owners without selected tests in this scope/status/profile: `${_uncovered}`. "
            "They may be covered by downstream tests, but have no owner test selected.\n")
    endif()
    file(APPEND "${_report}"
        "\n`candidate`: pending review; `unreviewed`: historical provenance unknown; "
        "`curated`: human approved. CTest case counts are known after build.\n")
    message(STATUS "[TestSelection] Report: ${_report}")
endfunction()

function(rs2026_finalize_test_options)
    if(NOT RS2026_TEST_SCOPE MATCHES "^(SELECTED|COMPONENT|PACKAGE|IMPACTED|FULL)$")
        message(FATAL_ERROR "Invalid RS2026_TEST_SCOPE: ${RS2026_TEST_SCOPE}")
    endif()
    get_property(_paths GLOBAL PROPERTY RS2026_TEST_CATALOG_PATHS)
    set(_packages)
    set(_components)
    foreach(_path IN LISTS _paths)
        string(MD5 _key "${_path}")
        get_property(_package GLOBAL PROPERTY "RS2026_TEST_${_key}_PACKAGE")
        get_property(_component GLOBAL PROPERTY "RS2026_TEST_${_key}_COMPONENT")
        list(APPEND _packages "${_package}")
        if(_package STREQUAL RS2026_TEST_PACKAGE)
            list(APPEND _components "${_component}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _packages)
    list(REMOVE_DUPLICATES _components)
    set_property(CACHE Test_Package PROPERTY STRINGS ${_packages})
    set_property(CACHE Test_Component PROPERTY STRINGS ${_components})
    foreach(_package IN LISTS _packages)
        cmake_dependent_option(TestPackage_${_package}
            "Enable catalog tests owned by package ${_package} in SELECTED scope"
            ON "Test_Enabled;Test_Scope STREQUAL SELECTED" OFF)
        set(_package_components)
        foreach(_path IN LISTS _paths)
            string(MD5 _key "${_path}")
            get_property(_owner_package GLOBAL PROPERTY "RS2026_TEST_${_key}_PACKAGE")
            if(_owner_package STREQUAL _package)
                get_property(_owner_component GLOBAL PROPERTY "RS2026_TEST_${_key}_COMPONENT")
                list(APPEND _package_components "${_owner_component}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES _package_components)
        foreach(_component IN LISTS _package_components)
            cmake_dependent_option(Test${_package}_${_component}
                "Enable catalog tests owned by ${_package}::${_component} in SELECTED scope"
                ON "TestPackage_${_package}" OFF)
        endforeach()
    endforeach()
    if(NOT BUILD_TESTING)
        return()
    endif()
    if(NOT RS2026_TEST_INCLUDE_CURATED AND NOT RS2026_TEST_INCLUDE_CANDIDATE
       AND NOT RS2026_TEST_INCLUDE_UNREVIEWED)
        message(FATAL_ERROR "Select at least one test governance status")
    endif()
    if(RS2026_TEST_SCOPE STREQUAL "COMPONENT" OR
       RS2026_TEST_SCOPE STREQUAL "PACKAGE" OR
       RS2026_TEST_SCOPE STREQUAL "IMPACTED")
        if(NOT RS2026_TEST_PACKAGE IN_LIST _packages)
            message(FATAL_ERROR "Select an available RS2026_TEST_PACKAGE")
        endif()
    endif()
    if(RS2026_TEST_SCOPE STREQUAL "COMPONENT" OR
       RS2026_TEST_SCOPE STREQUAL "IMPACTED")
        if(NOT RS2026_TEST_COMPONENT IN_LIST _components)
            message(FATAL_ERROR "Select an available RS2026_TEST_COMPONENT")
        endif()
    endif()
    if(RS2026_TEST_SCOPE STREQUAL "IMPACTED")
        if(RS2026_TEST_SUBMODULE)
            message(FATAL_ERROR
                "IMPACTED cannot filter by RS2026_TEST_SUBMODULE: doing so would discard downstream consumer tests. Select the owning component and its consumer closure instead")
        endif()
        _rs2026_compute_impacted_owners()
    endif()
endfunction()

function(_rs2026_require_production_link _consumer _producer)
    if(NOT TARGET ${_consumer})
        return()
    endif()
    get_target_property(_links ${_consumer} LINK_LIBRARIES)
    get_target_property(_interface_links ${_consumer} INTERFACE_LINK_LIBRARIES)
    string(FIND "${_links};${_interface_links}" "${_producer}" _position)
    if(_position EQUAL -1)
        message(FATAL_ERROR
            "IMPACTED metadata expects ${_consumer} to link ${_producer}, but the production target does not")
    endif()
endfunction()

function(_rs2026_validate_impact_production_links)
    if(NOT RS2026_TEST_SCOPE STREQUAL "IMPACTED")
        return()
    endif()
    _rs2026_require_production_link(
        SimulationRuntime SMRobotPlatform::SimulationProject)
    _rs2026_require_production_link(
        ProjectSimulationSDK SMRobotPlatform::SimulationProject)
    _rs2026_require_production_link(
        RobotViewerCore SMRobotPlatform::SimulationProject)
    _rs2026_require_production_link(
        RobotQtViewer SMRobotPlatform::SimulationProject)
    _rs2026_require_production_link(
        SimulationRuntime SMRobotCore::Collision)
    _rs2026_require_production_link(
        RobotRenderBridge SMRobotCore::Collision)
endfunction()

function(_rs2026_define_test_runner _name _dirs _targets)
    list(REMOVE_DUPLICATES _dirs)
    list(REMOVE_DUPLICATES _targets)
    list(LENGTH _dirs _count)
    set(_manifest "${CMAKE_BINARY_DIR}/RS2026${_name}TestDirs.cmake")
    file(WRITE "${_manifest}" "set(RS2026_SELECTED_TEST_DIRS\n")
    foreach(_dir IN LISTS _dirs)
        file(APPEND "${_manifest}" "    [==[${_dir}]==]\n")
    endforeach()
    file(APPEND "${_manifest}" ")\n")
    foreach(_config DEBUG RELEASE)
        set(_runtime_dirs)
        foreach(_provider Boost::log Qt5::Core CoACD::coacd)
            if(TARGET ${_provider})
                get_target_property(_location ${_provider} "IMPORTED_LOCATION_${_config}")
                if(NOT _location OR _location MATCHES "-NOTFOUND$")
                    get_target_property(_location ${_provider} IMPORTED_LOCATION)
                endif()
                if(_location AND NOT _location MATCHES "-NOTFOUND$")
                    get_filename_component(_runtime_dir "${_location}" DIRECTORY)
                    if(IS_DIRECTORY "${_runtime_dir}")
                        list(APPEND _runtime_dirs "${_runtime_dir}")
                    endif()
                endif()
            endif()
        endforeach()
        list(REMOVE_DUPLICATES _runtime_dirs)
        file(APPEND "${_manifest}" "set(RS2026_TEST_RUNTIME_DIRS_${_config}\n")
        foreach(_runtime_dir IN LISTS _runtime_dirs)
            file(APPEND "${_manifest}" "    [==[${_runtime_dir}]==]\n")
        endforeach()
        file(APPEND "${_manifest}" ")\n")
    endforeach()
    add_custom_target(RS2026_Build${_name}Tests)
    set_target_properties(RS2026_Build${_name}Tests PROPERTIES FOLDER "Tests/Actions")
    if(_targets)
        add_dependencies(RS2026_Build${_name}Tests ${_targets})
    endif()
    add_custom_target(RS2026_Run${_name}Tests
        COMMAND "${CMAKE_COMMAND}"
            "-DRS2026_TEST_DIRS_FILE=${_manifest}"
            "-DRS2026_TEST_CONFIG=$<CONFIG>"
            "-DRS2026_TEST_BUILD_ROOT=${CMAKE_BINARY_DIR}"
            -P "${CMAKE_SOURCE_DIR}/cmake/RS2026RunSelectedTests.cmake"
        DEPENDS RS2026_Build${_name}Tests
        USES_TERMINAL VERBATIM)
    set_target_properties(RS2026_Run${_name}Tests PROPERTIES FOLDER "Tests/Actions")
    message(STATUS "[TestSelection] ${_name}: ${_count} test directories")
endfunction()

function(rs2026_finalize_test_targets)
    rs2026_validate_test_catalog()
    _rs2026_write_test_catalog_report()
    if(NOT BUILD_TESTING)
        return()
    endif()
    _rs2026_validate_impact_production_links()
    _rs2026_validate_registered_test_dirs("${CMAKE_SOURCE_DIR}")
    get_property(_dirs GLOBAL PROPERTY RS2026_SELECTED_TEST_DIRS)
    get_property(_targets GLOBAL PROPERTY RS2026_SELECTED_TEST_TARGETS)
    if(NOT _dirs)
        message(FATAL_ERROR "No tests selected for ${RS2026_TEST_SCOPE}/${RS2026_TEST_PACKAGE}/${RS2026_TEST_COMPONENT}")
    endif()
    _rs2026_define_test_runner(Selected "${_dirs}" "${_targets}")
    _rs2026_write_test_selection_report()
    message(STATUS
        "[TestSelection] Generated Visual Studio targets RS2026_BuildSelectedTests and RS2026_RunSelectedTests (these are not CMake GUI cache options)")
    foreach(_status curated candidate unreviewed)
        get_property(_status_dirs GLOBAL PROPERTY "RS2026_SELECTED_TEST_DIRS_${_status}")
        get_property(_status_targets GLOBAL PROPERTY "RS2026_SELECTED_TEST_TARGETS_${_status}")
        if(_status STREQUAL "curated")
            set(_name Curated)
        elseif(_status STREQUAL "candidate")
            set(_name Candidate)
        else()
            set(_name Unreviewed)
        endif()
        _rs2026_define_test_runner(${_name} "${_status_dirs}" "${_status_targets}")
    endforeach()
endfunction()
