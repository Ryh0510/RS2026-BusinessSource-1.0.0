include("${CMAKE_CURRENT_LIST_DIR}/DependencyProviders.cmake")
include(CMakePrintHelpers)
set(_rs_ubuntu_module_path "${CMAKE_MODULE_PATH}")
set(THIRDPARTY_HEADONLY_DIR "${SMROBOT_THIRDPARTY_ROOT}" CACHE PATH "Header-only provider root for this machine")
set(RS2026_UBUNTU_PROVIDER_DIR "${SMROBOT_THIRDPARTY_ROOT}/Ubuntu" CACHE PATH "Ubuntu dependency finder directory")
set(PackDIR_Qt5 "/opt/Qt5.15.8/lib/cmake/Qt5" CACHE PATH "Local Qt5 Config directory; confirm on the selected Ubuntu machine")
set(PINOCCHIO_DIR "/opt/openrobots" CACHE PATH "Optional Pinocchio/urdfdom installation prefix")
message(STATUS "[Dependency ${RS2026_SELECTED_PROFILE}] Ubuntu paths are machine defaults; real-machine verification is required")

macro(_rs_ubuntu_provider finder label)
    rs_dependency_provider_required(_rs_ubuntu_load "${label}" ${ARGN})
    if(_rs_ubuntu_load)
        rs_include_dependency_provider(${finder})
        rs_assert_requested_provider_targets(${ARGN})
    endif()
endmacro()

set(CMAKE_MODULE_PATH "${THIRDPARTY_HEADONLY_DIR}")
set(_rs_ubuntu_prebuilt_assets OFF)
foreach(_component AssetCore RenderCore SceneCore)
    rs_prebuilt_component_required(_needed SMRobotPlatform ${_component})
    if(_needed)
        set(_rs_ubuntu_prebuilt_assets ON)
    endif()
endforeach()
rs_dependency_provider_required(_rs_ubuntu_glm glm glm)
if(_rs_ubuntu_prebuilt_assets)
    rs_force_dependency_provider(_rs_ubuntu_glm glm "prebuilt Platform asset interfaces")
endif()
if(_rs_ubuntu_glm)
    rs_include_dependency_provider(Findglm_3rdParty)
    rs_assert_dependency_provider_targets(glm glm::glm)
endif()
rs_dependency_provider_required(_rs_ubuntu_eigen Eigen3 Eigen3 fcl ccd octomap ompl pinocchio urdfdom urdfdom_headers)
if(UsingPrebuilt_SMRobotCore OR UsingPrebuilt_SMRobotPlatform)
    rs_force_dependency_provider(_rs_ubuntu_eigen Eigen3 "prebuilt Core/Platform interface")
endif()
if(_rs_ubuntu_eigen)
    rs_include_dependency_provider(FindEigen_3rdParty)
    rs_assert_dependency_provider_targets(Eigen3 Eigen3::Eigen)
endif()
_rs_ubuntu_provider(Findnlohmann_json_3rdParty nlohmann_json nlohmann_json)

set(CMAKE_MODULE_PATH "${RS2026_UBUNTU_PROVIDER_DIR}")
rs_dependency_provider_required(_rs_ubuntu_boost Boost Boost ompl pinocchio urdfdom urdfdom_headers)
rs_optional_boost_program_options_required(_rs_ubuntu_optional_program_options)
if(_rs_ubuntu_optional_program_options)
    rs_force_dependency_provider(_rs_ubuntu_boost Boost
        "enabled Platform feature probe requires Boost program_options")
endif()
if(_rs_ubuntu_boost)
    rs_project_required_components(Boost Boost_Components)
    if(_rs_ubuntu_optional_program_options)
        list(APPEND Boost_Components program_options)
    endif()
    if("ompl" IN_LIST RS2026_REQUIRED_PACKAGES)
        list(APPEND Boost_Components serialization)
    endif()
    list(REMOVE_DUPLICATES Boost_Components)
    rs_include_dependency_provider(${RS2026_PROFILE_BOOST_FINDER})
    rs_assert_requested_provider_targets(Boost)
endif()
rs_dependency_provider_required(_rs_ubuntu_glfw glfw glfw)
rs_optional_glfw_required(_rs_ubuntu_optional_glfw)
if(_rs_ubuntu_glfw OR _rs_ubuntu_optional_glfw)
    rs_include_dependency_provider(${RS2026_PROFILE_GLFW_FINDER})
    rs_assert_dependency_provider_targets(glfw glfw::glfw)
endif()
rs_dependency_provider_required(_rs_ubuntu_freeglut FreeGLUT FreeGLUT)
rs_optional_freeglut_required(_rs_ubuntu_optional_freeglut)
if(_rs_ubuntu_optional_freeglut)
    rs_force_dependency_provider(_rs_ubuntu_freeglut FreeGLUT
        "enabled diagnostic or feature probe requires FreeGLUT")
endif()
if(_rs_ubuntu_freeglut)
    rs_include_dependency_provider(${RS2026_PROFILE_FREEGLUT_FINDER})
    rs_assert_dependency_provider_targets(FreeGLUT FreeGLUT::freeglut)
endif()
rs_dependency_provider_required(_rs_ubuntu_assimp assimp assimp)
if(_rs_ubuntu_prebuilt_assets)
    rs_force_dependency_provider(_rs_ubuntu_assimp assimp "prebuilt Platform asset runtime")
endif()
if(_rs_ubuntu_assimp)
    rs_include_dependency_provider(${RS2026_PROFILE_ASSIMP_FINDER})
    rs_assert_dependency_provider_targets(assimp assimp::assimp)
endif()
_rs_ubuntu_provider(CMake_Findfcl_System FCL fcl ccd octomap)
if(NOT RS2026_PROFILE_OMPL_FINDER)
    set(RS2026_PROFILE_OMPL_FINDER CMake_Findompl_System)
endif()
_rs_ubuntu_provider(${RS2026_PROFILE_OMPL_FINDER} OMPL ompl)
_rs_ubuntu_provider(CMake_FindKTX KTX KTX)
_rs_ubuntu_provider(FindCoACD_3rdParty CoACD CoACD)
_rs_ubuntu_provider(CMake_FindOpenSSL_System OpenSSL OpenSSL)

# URDF loading does not require the optional Pinocchio algorithm providers.
rs_dependency_provider_required(_rs_ubuntu_urdf urdfdom urdfdom urdfdom_headers console_bridge)
rs_prebuilt_component_required(_rs_ubuntu_prebuilt_io SMRobotCore RobotIO)
if(_rs_ubuntu_prebuilt_io)
    rs_force_dependency_provider(_rs_ubuntu_urdf urdfdom "prebuilt Core RobotIO runtime")
endif()
if(_rs_ubuntu_urdf)
    rs_include_dependency_provider(FindUrdfdomSystem)
    rs_assert_dependency_provider_targets(urdfdom urdfdom::urdfdom_model urdfdom_headers::urdfdom_headers)
endif()
_rs_ubuntu_provider(CMake_Findpinocchio_System pinocchio pinocchio)

rs_dependency_provider_required(_rs_ubuntu_qt Qt5 Qt5)
if(_rs_ubuntu_qt)
    if(EXISTS "${RS2026_DEPENDENCY_PROVIDER_OVERRIDE_DIR}/CMake_FindQt515x.cmake")
        rs_include_dependency_provider(CMake_FindQt515x)
    elseif(RS2026_ENABLE_DEMAND_LOADING AND RS2026_DEPENDENCY_SNAPSHOT_COMPLETE)
        rs_project_required_components(Qt5 _rs_ubuntu_qt_components)
        if(NOT EXISTS "${PackDIR_Qt5}/Qt5Config.cmake")
            message(FATAL_ERROR "[Dependency ${RS2026_SELECTED_PROFILE}] Required Qt5 Config is absent. "
                "Set -DPackDIR_Qt5=<local-config-directory>; current=${PackDIR_Qt5}")
        endif()
        find_package(Qt5 5.15 CONFIG REQUIRED COMPONENTS ${_rs_ubuntu_qt_components}
            PATHS "${PackDIR_Qt5}" NO_DEFAULT_PATH)
    else()
        rs_include_dependency_provider(CMake_FindQt515x)
    endif()
    rs_assert_requested_provider_targets(Qt5)
endif()
rs_dependency_provider_required(_rs_ubuntu_opengl OpenGL OpenGL)
if(_rs_ubuntu_opengl)
    if(EXISTS "${RS2026_DEPENDENCY_PROVIDER_OVERRIDE_DIR}/FindOpenGL.cmake")
        rs_include_dependency_provider(FindOpenGL)
    else()
        find_package(OpenGL REQUIRED)
    endif()
    rs_assert_requested_provider_targets(OpenGL)
endif()
if(BUILD_TESTING OR BuildExample_SMRobotCore)
    if(EXISTS "${RS2026_DEPENDENCY_PROVIDER_OVERRIDE_DIR}/FindGTest_3rdParty.cmake")
        rs_include_dependency_provider(FindGTest_3rdParty)
    else()
        find_package(GTest REQUIRED)
    endif()
endif()
set(CMAKE_MODULE_PATH "${_rs_ubuntu_module_path}")
