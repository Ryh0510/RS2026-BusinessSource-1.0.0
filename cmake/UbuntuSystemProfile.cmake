# Shared system-package defaults for new Ubuntu profiles.
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "${RS2026_SELECTED_PROFILE} requires Linux")
endif()
file(STRINGS "/etc/os-release" _rs_ubuntu_version REGEX "^VERSION_ID=")
string(REPLACE "VERSION_ID=" "" _rs_ubuntu_version "${_rs_ubuntu_version}")
string(REPLACE "\"" "" _rs_ubuntu_version "${_rs_ubuntu_version}")
if(NOT _rs_ubuntu_version STREQUAL RS2026_UBUNTU_TARGET_VERSION)
    message(FATAL_ERROR "Ubuntu profile expects ${RS2026_UBUNTU_TARGET_VERSION}, running ${_rs_ubuntu_version}. Use a matching build environment.")
endif()
set(RS2026_PROFILE_BOOST_FINDER FindBoostSystem)
set(RS2026_PROFILE_OMPL_FINDER FindOmplSystem)
set(RS2026_PROFILE_ASSIMP_FINDER CMake_Findassimp_System)
set(RS2026_PROFILE_GLFW_FINDER CMake_FindGLFW3_System)
set(RS2026_PROFILE_FREEGLUT_FINDER CMake_Findfreeglut_System)
set(PackDIR_Qt5 "/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}/cmake/Qt5" CACHE PATH "Qt5 Config directory")
include("${CMAKE_CURRENT_LIST_DIR}/UbuntuDependencyProviders.cmake")
